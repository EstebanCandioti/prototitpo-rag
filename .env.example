# Solo servidor. Copiar a .env sin sobrescribir una configuración existente.
DATABASE_URL=postgresql://usuario:clave@127.0.0.1:5432/rag
URL_EMBEDDINGS=http://localhost:11434/v1
MODELO_EMBEDDINGS=bge-m3
DIMENSIONES=1024
PROVEEDOR_CHAT=openai
URL_CHAT=https://api.openai.com/v1
MODELO_CHAT=gpt-6-luna
API_KEY=
PUERTO_WEB=3000
NODE_ENV=development
AUTH_MODE=desarrollo
DIAGNOSTICOS_HABILITADOS=true
RAG_K=8
UMBRAL=0.55
CUOTA_CONSULTAS_DIA=50
CUOTA_DIAGNOSTICOS_DIA=200
CHAT_MAX_SALIDA_TOKENS=4096
CHAT_TIMEOUT_MS=90000
EMBEDDING_TIMEOUT_MS=180000
# Cargar tarifas revisadas por modelo informado; vacío significa costo desconocido.
TARIFAS_MODELOS_JSON={}
# Solo para la prueba PostgreSQL optativa con esquema aislado:
# TEST_DATABASE_URL=postgresql://usuario:clave@127.0.0.1:5432/base_de_pruebas
